# Matplotlib style of the figures; every notebook loads it with
# mpl.rc_file. Sizes are those of Nature figures (text 5-7 pt).

lines.linewidth: 1.05
lines.markeredgecolor: None
lines.markeredgewidth: 0.7
lines.markersize: 4.2
patch.linewidth: 0.7
hatch.linewidth: 0.7
boxplot.whiskers: 1.05
boxplot.flierprops.markeredgewidth: 0.7
boxplot.flierprops.linewidth: 0.7
boxplot.boxprops.linewidth: 0.7
boxplot.whiskerprops.linewidth: 0.7
boxplot.capprops.linewidth: 0.7
boxplot.medianprops.linewidth: 0.7
boxplot.meanprops.markersize: 4.2
boxplot.meanprops.linewidth: 0.7
font.size: 7.0
font.sans-serif: Helvetica, Arial
text.hinting: none  # Helvetica's hinting bytecode divides by zero in matplotlib >= 3.11
mathtext.fontset: custom
mathtext.fallback: stixsans
axes.linewidth: 0.56
axes.titlesize: medium
axes.titlepad: 4.2
axes.labelpad: 2.8
axes.spines.top: False
axes.spines.right: False
axes.xmargin: .035
axes.ymargin: .035
axes.zmargin: .035
xtick.major.size: 2.45
xtick.minor.size: 1.4
xtick.major.width: 0.56
xtick.minor.width: 0.42
xtick.major.pad: 2.45
xtick.minor.pad: 2.38
ytick.major.size: 2.45
ytick.minor.size: 1.4
ytick.major.width: 0.56
ytick.minor.width: 0.42
ytick.major.pad: 2.45
ytick.minor.pad: 2.38
grid.linewidth: 0.56
legend.frameon: False
legend.fancybox: False
legend.borderpad: 0.28
legend.labelspacing: 0.35
legend.handlelength: 1.4
legend.handleheight: 0.49
legend.handletextpad: 0.56
legend.borderaxespad: 0.35
legend.columnspacing: 1.4
figure.titlesize: medium
figure.labelsize: medium
figure.figsize: 3.4, 2.1
figure.max_open_warning: 50
figure.subplot.left: 0.0875
figure.subplot.right: 0.72
figure.subplot.bottom: 0.077
figure.subplot.top: 0.616
figure.subplot.wspace: 0.14
figure.subplot.hspace: 0.14
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.02917
figure.constrained_layout.w_pad: 0.02917
figure.constrained_layout.hspace: 0.014
figure.constrained_layout.wspace: 0.014
hist.bins: auto
scatter.marker: .
savefig.dpi: 600
savefig.format: pdf
savefig.pad_inches: 0.0
savefig.transparent: True
ps.fonttype: 42
pdf.fonttype: 42
svg.fonttype: none
animation.embed_limit: 100.0
svg.hashsalt: qising-networks  # fixed SVG ids, so the same figure gives the same file
